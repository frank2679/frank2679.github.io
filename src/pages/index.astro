---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const skills = [
  { label: 'C++ / C', level: 'Expert', levelZh: '精通' },
  { label: 'CUDA', level: 'Expert', levelZh: '精通' },
  { label: 'Python', level: 'Proficient', levelZh: '熟练' },
  { label: 'BLAS / GEMM', level: 'Expert', levelZh: '精通' },
  { label: 'Performance Optimization', level: 'Expert', levelZh: '精通' },
  { label: 'Deep Learning', level: 'Proficient', levelZh: '熟练' },
  { label: 'CMake / Make', level: 'Proficient', levelZh: '熟练' },
  { label: 'Git / CI/CD', level: 'Proficient', levelZh: '熟练' },
  { label: 'Claude Code / MCP / Agents', level: 'Proficient', levelZh: '熟练' },
];

const featured = [
  {
    titleEn: 'BLAS Library from Scratch',
    titleZh: '从零构建 BLAS 库',
    descEn: 'Built production-grade BLAS acceleration library on GPGPU, achieving A100-level performance on LLMs (Qwen, Llama2, GPT series).',
    descZh: '在自研 GPGPU 平台上从零搭建生产级 BLAS 加速库，在 Qwen、Llama2、GPT 等大模型上实现 A100 同等水平的性能。',
    tags: ['C++', 'CUDA', 'BLAS', 'LLM'],
    href: '/projects',
  },
  {
    titleEn: 'Kernel Template Library (KTL)',
    titleZh: '算子模板库（KTL）',
    descEn: 'CUTLASS v3.x-style kernel template library for the AI harness, covering GEMM, conv, and fusion operators with AI codegen support.',
    descZh: '面向 AI harness 的 CUTLASS v3.x 风格算子模板库，覆盖 GEMM、conv 及 fusion 算子，支持 AI codegen。',
    tags: ['CUTLASS', 'C++', 'KTL'],
    href: '/projects',
  },
  {
    titleEn: 'DNN Framework Development',
    titleZh: 'DNN 框架开发',
    descEn: 'Developed deep learning framework with precision verification, self-defined operator/graph expression via YAML.',
    descZh: '开发支持精度验证的深度学习框架，基于 YAML 自定义算子/图表达方式。',
    tags: ['Python', 'C++', 'DNN', 'PyTorch'],
    href: '/projects',
  },
];
---

<BaseLayout title="Frank Young — HPC Engineer">
  <Nav />

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container">
        <div class="hero-badge">
          <span class="dot"></span>
          <span data-i18n="en">Available for interesting opportunities</span>
          <span data-i18n="zh">欢迎有趣的工作机会</span>
        </div>
        <h1 class="hero-name">Frank Young</h1>
        <p class="hero-title">
          <span data-i18n="en">High-Performance Computing Engineer</span>
          <span data-i18n="zh">高性能计算工程师</span>
        </p>
        <p class="hero-desc" data-i18n="en">
          9+ years building AI acceleration infrastructure — BLAS libraries, GEMM optimizations,
          and DNN frameworks on heterogeneous platforms. Currently at
          <a href="https://damo.alibaba.com" target="_blank" rel="noopener noreferrer">Alibaba DAMO Academy</a>.
        </p>
        <p class="hero-desc" data-i18n="zh">
          9 年以上 AI 加速基础设施开发经验——涵盖异构平台上的 BLAS 库、GEMM 优化及 DNN 框架。目前就职于
          <a href="https://damo.alibaba.com" target="_blank" rel="noopener noreferrer">阿里达摩院</a>。
        </p>
        <div class="hero-actions">
          <a href="/resume" class="btn btn-primary">
            <span data-i18n="en">View Resume</span><span data-i18n="zh">查看简历</span>
          </a>
          <a href="/projects" class="btn btn-ghost">
            <span data-i18n="en">See Projects</span><span data-i18n="zh">查看项目</span>
          </a>
          <a href="https://github.com/frank2679" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 6px;">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section class="section">
      <div class="container">
        <h2 class="section-label">
          <span data-i18n="en">// Skills</span><span data-i18n="zh">// 技能</span>
        </h2>
        <div class="skills-grid">
          {skills.map(({ label, level, levelZh }) => (
            <div class="skill-item">
              <span class="skill-name">{label}</span>
              <span class:list={['skill-level', level.toLowerCase().replace(' ', '-')]}>
                <span data-i18n="en">{level}</span><span data-i18n="zh">{levelZh}</span>
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="section">
      <div class="container">
        <div class="section-header">
          <h2 class="section-label">
            <span data-i18n="en">// Featured Projects</span><span data-i18n="zh">// 精选项目</span>
          </h2>
          <a href="/projects" class="see-all">
            <span data-i18n="en">See all →</span><span data-i18n="zh">查看全部 →</span>
          </a>
        </div>
        <div class="projects-grid">
          {featured.map(({ titleEn, titleZh, descEn, descZh, tags, href }) => (
            <a href={href} class="featured-card">
              <h3><span data-i18n="en">{titleEn}</span><span data-i18n="zh">{titleZh}</span></h3>
              <p><span data-i18n="en">{descEn}</span><span data-i18n="zh">{descZh}</span></p>
              <div class="tags">
                {tags.map((t) => <span class="tag">{t}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Recent Posts -->
    {recentPosts.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-header">
            <h2 class="section-label">
              <span data-i18n="en">// Recent Posts</span><span data-i18n="zh">// 最新文章</span>
            </h2>
            <a href="/blog" class="see-all">
              <span data-i18n="en">All posts →</span><span data-i18n="zh">全部文章 →</span>
            </a>
          </div>
          <div class="posts-list">
            {recentPosts.map((post) => (
              <PostCard
                title={post.data.title}
                date={post.data.date}
                slug={post.id}
                tags={post.data.tags}
                description={post.data.description}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Contact -->
    <section class="section contact-section">
      <div class="container">
        <div class="contact-box">
          <h2><span data-i18n="en">Get in Touch</span><span data-i18n="zh">取得联系</span></h2>
          <p data-i18n="en">Interested in collaborating on high-performance computing, AI infrastructure, or just want to chat about technology?</p>
          <p data-i18n="zh">如果你对高性能计算、AI 基础设施感兴趣，或者只是想聊聊技术，欢迎联系我。</p>
          <a href="mailto:2679frank@gmail.com" class="btn btn-primary">2679frank@gmail.com</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 5rem 0 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, var(--accent)0a 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .dot {
    width: 8px;
    height: 8px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.5rem;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-title {
    font-size: 1.25rem;
    color: var(--accent);
    font-family: var(--font-mono);
    margin-bottom: 1.25rem;
    font-weight: 400;
  }

  .hero-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 580px;
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius);
    font-weight: 500;
    font-size: 0.9rem;
    transition: all 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background: var(--accent);
    color: #0a0a0f;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    color: #0a0a0f;
    transform: translateY(-1px);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .btn-ghost:hover {
    border-color: var(--accent)55;
    color: var(--text-primary);
    background: var(--bg-card);
  }

  /* Sections */
  .section {
    padding: 3rem 0;
    border-top: 1px solid var(--border);
  }

  .section-label {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 500;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .section-header .section-label {
    margin-bottom: 0;
  }

  .see-all {
    color: var(--text-muted);
    font-size: 0.85rem;
    transition: color 0.2s;
  }

  .see-all:hover {
    color: var(--accent);
  }

  /* Skills */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.6rem;
  }

  .skill-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.6rem 0.9rem;
    transition: border-color 0.2s;
  }

  .skill-item:hover {
    border-color: var(--accent)44;
  }

  .skill-name {
    font-size: 0.875rem;
    color: var(--text-primary);
    font-weight: 500;
  }

  .skill-level {
    font-size: 0.72rem;
    font-family: var(--font-mono);
    padding: 0.15em 0.5em;
    border-radius: 4px;
  }

  .skill-level.expert {
    background: var(--accent)22;
    color: var(--accent);
  }

  .skill-level.proficient {
    background: #6e6e8a22;
    color: var(--text-secondary);
  }

  /* Featured Projects */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .featured-card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: border-color 0.2s, transform 0.2s;
  }

  .featured-card:hover {
    border-color: var(--accent)55;
    transform: translateY(-2px);
  }

  .featured-card h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.6rem;
  }

  .featured-card p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    line-height: 1.65;
    margin-bottom: 1rem;
  }

  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  /* Posts */
  .posts-list {
    border-top: 1px solid var(--border);
  }

  /* Contact */
  .contact-section {
    margin-bottom: 2rem;
  }

  .contact-box {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    text-align: center;
  }

  .contact-box h2 {
    font-size: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .contact-box p {
    color: var(--text-secondary);
    max-width: 480px;
    margin: 0 auto 1.5rem;
  }
</style>
