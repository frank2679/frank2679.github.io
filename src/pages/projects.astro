---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = [
  {
    titleEn: 'Kernel Template Library (KTL) Development',
    titleZh: '算子模板库（KTL）开发',
    period: '2025.07 – Present',
    descriptionEn:
      'Started as a CUTLASS framework and CuTe layout algebra research effort, porting a generalized GEMM implementation to a new chip. Pivoted to building a CUTLASS v3.x-style kernel template library (KTL) for the AI harness and expert kernel engineers.',
    descriptionZh:
      '起步于对 CUTLASS 框架和 CuTe layout 算术的预研，将泛化的 GEMM 实现移植到新的芯片架构。之后转向面向 AI harness 和算子专家的 CUTLASS v3.x 风格算子模板库（KTL）开发。',
    tags: ['C++', 'CUTLASS', 'GEMM', 'KTL', 'AI Harness', 'Codegen'],
    highlightsEn: [
      '2025.07–2025.09: Studied CuTe layout algebra and the CUTLASS programming model in depth; ported a generalized GEMM implementation to a new chip',
      '2026.06–Present: Pivoted to a CUTLASS v3.x-style kernel template library (KTL) for the AI harness',
      'Covers elementwise, reduce, GEMM, conv, normalization, activation, and fusion operators (e.g., attention, MoE)',
      'Supports AI codegen and header-only invocation for generating high-performance operators',
    ],
    highlightsZh: [
      '2025.07–2025.09：深入预研 CuTe layout 算术与 CUTLASS 编程范式，将泛化 GEMM 实现移植至新的芯片架构',
      '2026.06–至今：转向面向 AI harness 的 CUTLASS v3.x 风格算子模板库（KTL）开发',
      '覆盖 elementwise、reduce、GEMM、conv、normalization、activation 及 attention、MoE 等 fusion 算子',
      '支持 AI codegen 与头文件调用，用于生成高性能算子',
    ],
  },
  {
    titleEn: 'BLAS Library — Production-Grade Acceleration',
    titleZh: 'BLAS 库 — 生产级加速',
    period: '2023.06 – 2024.11',
    descriptionEn:
      'Built a full BLAS acceleration library from scratch on a proprietary GPGPU platform. The library powers LLM inference at A100-equivalent throughput, covering GEMM, batched GEMM, and strided variants.',
    descriptionZh:
      '在自研 GPGPU 平台上从零构建完整的 BLAS 加速库，支撑 LLM 推理达到 A100 同等吞吐水平，覆盖 GEMM、batched GEMM 及 strided 变体。',
    tags: ['C++', 'CUDA', 'BLAS', 'GEMM', 'LLM', 'Performance'],
    highlightsEn: [
      'End-to-end ownership: kernel development, testing harness, kernel selection, benchmarking, CI/CD, docs',
      'Optimized for Qwen, Llama2, GPT-series model shapes — matched A100 on first-gen chip',
      'Implemented warp-specialized programming, fused bias, fused grad accumulation, BF16 accumulation',
      '3 patents filed',
    ],
    highlightsZh: [
      '端到端负责：算子开发、测试框架、kernel selection、benchmark、CI/CD、文档',
      '泛化支持 Qwen、Llama2、GPT 系列模型 shape，在第一代芯片上性能打平 A100',
      '实现 warp-specialized 编程范式、fused bias、fused grad 累加、BF16 累加',
      '申请 3 项专利',
    ],
  },
  {
    titleEn: 'Ultimate GEMM Optimization',
    titleZh: 'GEMM 极致优化',
    period: '2021.09 – 2021.10 · 2025.06 – 2025.08',
    descriptionEn:
      'Push-to-limits GEMM implementation using handwritten assembly and Verdi waveform analysis. Achieved full chip utilization for specific matrix shapes on both Vcore and Tcore architectures.',
    descriptionZh:
      '通过手写汇编与 Verdi 波形分析，将 GEMM 性能推向极限，在 Vcore 与 Tcore 两种架构上均实现特定 shape 下的满利用率。',
    tags: ['Assembly', 'GEMM', 'Performance', 'Waveform Analysis'],
    highlightsEn: [
      'Handwritten assembly for inner loop to eliminate compiler overhead',
      'Used Verdi/SimVision for cycle-accurate waveform analysis and pipeline optimization',
      'Full chip utilization achieved on target shapes',
      '2 patents filed',
    ],
    highlightsZh: [
      '手写汇编实现内层循环，消除编译器开销',
      '使用 Verdi/SimVision 进行周期级波形分析与流水线优化',
      '在目标 shape 下实现满利用率',
      '申请 2 项专利',
    ],
  },
  {
    titleEn: 'DNN Framework Development',
    titleZh: 'DNN 框架开发',
    period: '2022.03 – 2023.06',
    descriptionEn:
      'Developed a deep learning framework with precision verification, inspired by PyTorch\'s design. Features a self-defined operator and graph expression system based on YAML configuration, with automated precision validation and performance benchmarking.',
    descriptionZh:
      '参考 PyTorch 设计开发支持精度验证的深度学习框架，基于 YAML 配置自定义算子与图表达方式，并实现自动化精度验证与性能对标。',
    tags: ['Python', 'C++', 'DNN', 'Framework', 'YAML', 'PyTorch'],
    highlightsEn: [
      'Self-defined operator/graph DSL in YAML, compiled to executable kernels',
      'Automated precision validation against reference implementations',
      'Integrated performance benchmarking pipeline',
      'Software copyright registered',
    ],
    highlightsZh: [
      '基于 YAML 自定义算子/图 DSL，编译为可执行算子',
      '相对参考实现的自动化精度验证',
      '集成性能对标流水线',
      '已登记软件著作权',
    ],
  },
  {
    titleEn: 'CNN Library for AI Inference',
    titleZh: 'AI 推理 CNN 算子库',
    period: '2017.07 – 2020.12',
    descriptionEn:
      'High-performance convolutional neural network library for heterogeneous AI inference platforms at Hikvision. Optimized key operations across CPU, DSP, and NPU, supporting production surveillance AI workloads.',
    descriptionZh:
      '面向海康威视异构 AI 推理平台的高性能卷积神经网络库，优化 CPU、DSP、NPU 上的关键算子，支撑安防 AI 生产业务。',
    tags: ['C++', 'CNN', 'DSP', 'NPU', 'Computer Vision'],
    highlightsEn: [
      'Optimized convolution, pooling, and activation operators for custom hardware',
      'Cross-platform performance tuning for CPU, DSP, and NPU execution paths',
      'End-to-end delivery: requirements → architecture → optimization → deployment',
    ],
    highlightsZh: [
      '针对自研硬件优化卷积、池化、激活等算子',
      '跨 CPU/DSP/NPU 执行路径的性能调优',
      '端到端交付：需求 → 架构 → 优化 → 部署',
    ],
  },
  {
    titleEn: 'IEEE 802.11ax Research',
    titleZh: 'IEEE 802.11ax 协议研究',
    period: '2014.09 – 2017.01',
    descriptionEn:
      'Graduate research on next-generation WiFi (802.11ax/Wi-Fi 6) at National Taiwan University. Focused on UL OFDMA random access and energy-saving mechanisms, resulting in 2 IEEE publications.',
    descriptionZh:
      '在台湾大学从事下一代 WiFi（802.11ax / Wi-Fi 6）研究，聚焦上行 OFDMA 随机接入与节能机制，发表 2 篇 IEEE 论文。',
    tags: ['WiFi 6', '802.11ax', 'OFDMA', 'Research', 'C Simulation'],
    highlightsEn: [
      'Published in IEEE Access (2018): Energy saving mechanisms for 802.11ax',
      'Published at IEEE GLOBECOM 2017: UL OFDMA random access performance analysis',
      'Implemented simulation models in C for protocol performance evaluation',
    ],
    highlightsZh: [
      '发表于 IEEE Access（2018）：802.11ax 节能机制研究',
      '发表于 IEEE GLOBECOM 2017：上行 OFDMA 随机接入性能分析',
      '基于 C 语言实现协议性能评估仿真模型',
    ],
  },
];
---

<BaseLayout
  title="Projects — Frank Young"
  description="Technical projects by Frank Young in high-performance computing, AI acceleration, and systems engineering."
>
  <Nav />

  <main class="container">
    <section class="page-header">
      <h1><span data-i18n="en">Projects</span><span data-i18n="zh">项目</span></h1>
      <p class="subtitle">
        <span data-i18n="en">A record of technical work spanning GPU kernel optimization, AI infrastructure, and systems research.</span>
        <span data-i18n="zh">技术工作记录，涵盖 GPU 算子优化、AI 基础设施与系统研究。</span>
      </p>
    </section>

    <div class="projects-list">
      {projects.map((project) => (
        <ProjectCard
          titleEn={project.titleEn}
          titleZh={project.titleZh}
          period={project.period}
          descriptionEn={project.descriptionEn}
          descriptionZh={project.descriptionZh}
          tags={project.tags}
          highlightsEn={project.highlightsEn}
          highlightsZh={project.highlightsZh}
        />
      ))}
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    max-width: 560px;
    margin: 0;
  }

  .projects-list {
    display: grid;
    gap: 1.25rem;
  }
</style>
