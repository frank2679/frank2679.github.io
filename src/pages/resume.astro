---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Resume PDFs are synced from github.com/frank2679/resume-ng into
// public/resume/ at build time (see scripts/sync-resume.mjs) so they're
// served same-origin — no third-party CDN in the request path for visitors.
const REPO_URL = 'https://github.com/frank2679/resume-ng/tree/main/resume_release';

let resumeMeta: {
  syncedAt?: string;
  en?: { date: string; sourceName: string };
  cn?: { date: string; sourceName: string };
} | null = null;
try {
  const raw = fs.readFileSync(path.join(process.cwd(), 'public', 'resume', 'meta.json'), 'utf-8');
  resumeMeta = JSON.parse(raw);
} catch {
  resumeMeta = null;
}

function versionLabel(lang: 'en' | 'cn', prefix: string) {
  const entry = resumeMeta?.[lang];
  if (!entry) return null;
  return `${prefix} ${entry.date.slice(0, 4)}-${entry.date.slice(4)}`;
}

function formatSyncedAt(iso: string | undefined) {
  if (!iso) return null;
  const [datePart, timePart] = iso.split('T');
  if (!datePart || !timePart) return null;
  return `${datePart} ${timePart.slice(0, 5)} UTC`;
}

const enEntry = resumeMeta?.en ?? null;
const cnEntry = resumeMeta?.cn ?? null;
const syncedAtLabel = formatSyncedAt(resumeMeta?.syncedAt);
---

<BaseLayout
