---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<script is:inline>
  (function () {
    try {
      var saved = localStorage.getItem('resume-lang');
      var lang = saved || (navigator.language && navigator.language.startsWith('zh') ? 'zh' : 'en');
      document.documentElement.setAttribute('data-resume-lang', lang);
    } catch (e) {}
  })();
</script>

