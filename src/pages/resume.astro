<script>
  // iOS Safari (and some other mobile browsers) never implemented the
  // Fullscreen API for arbitrary elements, so requestFullscreen() silently
  // no-ops there. A CSS-only "pseudo-fullscreen" overlay works everywhere.
  function setExpanded(el: HTMLElement, expanded: boolean) {
    el.classList.toggle('is-expanded', expanded);
    document.body.style.overflow = expanded ? 'hidden' : '';
  }

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;

    const openBtn = target.closest('[data-fullscreen-target]') as HTMLElement | null;
    if (openBtn) {
      const id = openBtn.getAttribute('data-fullscreen-target');
      const el = id ? document.getElementById(id) : null;
      if (el) setExpanded(el, !el.classList.contains('is-expanded'));
      return;
    }

    const closeBtn = target.closest('[data-fullscreen-close]') as HTMLElement | null;
    if (closeBtn) {
      const wrap = closeBtn.closest('.pdf-frame-wrap') as HTMLElement | null;
      if (wrap) setExpanded(wrap, false);
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLElement>('.pdf-frame-wrap.is-expanded').forEach((el) => setExpanded(el, false));
  });
</script>

<style>
  main {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.4rem;
  }

  .subtitle {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .contact-row a,
  .contact-row span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .contact-row a:hover {
    color: var(--accent);
  }

  /* PDF viewer */
  .pdf-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pdf-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pdf-meta-text {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pdf-version {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .pdf-version a {
    color: var(--accent);
  }

  .pdf-synced {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.75;
  }

  .pdf-fullscreen-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .pdf-fullscreen-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .pdf-frame-wrap {
    position: relative;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    height: clamp(600px, 85vh, 1400px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pdf-frame-wrap.is-expanded {
    position: fixed;
    inset: 0;
    z-index: 1000;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    border-radius: 0;
    border: none;
  }

  .pdf-close-btn {
    display: none;
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    width: 2.25rem;
    height: 2.25rem;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  .pdf-close-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  .pdf-frame-wrap.is-expanded .pdf-close-btn {
    display: flex;
  }

  .pdf-frame {
    width: 100%;
    height: 100%;
    border: none;
  }

  .pdf-status {
    color: var(--text-secondary);
    font-size: 0.9rem;
    text-align: center;
    padding: 0 1.5rem;
  }

  @media (max-width: 640px) {
    .pdf-frame-wrap {
      height: clamp(460px, 75vh, 900px);
    }
  }
</style>
