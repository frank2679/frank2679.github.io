---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="About — Frank Young"
  description="Frank Young's professional background — Senior Software Engineer specializing in high-performance computing and AI acceleration."
>
  <Nav />

  <main class="container">
    <!-- Header -->
    <section class="page-header">
      <h1>Frank Young <span class="zh">杨行</span></h1>
      <p class="subtitle">Senior Software Engineer · High-Performance Computing</p>
      <div class="contact-row">
        <a href="mailto:2679frank@gmail.com">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          2679frank@gmail.com
        </a>
        <a href="https://github.com/frank2679" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          github.com/frank2679
        </a>
        <a href="https://www.linkedin.com/in/yang-hang-7b5631288/" target="_blank" rel="noopener noreferrer">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          linkedin.com/in/yang-hang
        </a>
        <span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.6 1h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.56a16 16 0 0 0 6 6l.85-.87a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16z"/></svg>
          (+86) 131-6207-0162
        </span>
      </div>
    </section>

    <!-- Bio -->
    <section class="resume-section">
      <h2 class="section-title">About</h2>
      <p class="summary-text">
        Senior software engineer with 9+ years building high-performance computation infrastructure for
        heterogeneous platforms (CPU/GPU/DSP/NPU) — from BLAS and DNN acceleration libraries to GEMM
        optimization and AI model deployment. Most of that work has been 0-to-1: picking the stack, standing
        up the framework, and getting core operators into production.
      </p>
      <p class="summary-text">
        Outside of work: triathlon — long-distance running, cycling, and swimming keep the mind sharp.
      </p>
      <p class="summary-text">
        <a href="/resume">Full résumé (EN / 中文) →</a>
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.4rem;
  }

  .zh {
    color: var(--text-muted);
    font-size: 0.7em;
    font-weight: 400;
    margin-left: 0.5rem;
  }

  .subtitle {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  .contact-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }

  .contact-row a,
  .contact-row span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    transition: color 0.2s;
  }

  .contact-row a:hover {
    color: var(--accent);
  }

  /* Sections */
  .resume-section {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-family: var(--font-mono);
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .section-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .summary-text {
    color: var(--text-secondary);
    line-height: 1.8;
    max-width: 720px;
  }

  .summary-text + .summary-text {
    margin-top: 0.75rem;
  }
</style>
