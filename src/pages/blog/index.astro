---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Collect all unique tags
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  title="Blog — Frank Young"
  description="Technical writing on high-performance computing, C++, AI acceleration, and engineering."
>
  <Nav />

  <main class="container">
    <section class="page-header">
      <h1><span data-i18n="en">Blog</span><span data-i18n="zh">博客</span></h1>
      <p class="subtitle">
        <span data-i18n="en">Notes on HPC, C++, AI acceleration, and life. Mostly in Chinese (中文).</span>
        <span data-i18n="zh">关于 HPC、C++、AI 加速和生活的随笔，大多数文章为中文。</span>
      </p>
    </section>

    {allTags.length > 0 && (
      <div class="tag-bar">
        <a href="#all" class="tag-filter active" data-tag-filter="all" aria-current="page">
          <span data-i18n="en">All</span><span data-i18n="zh">全部</span>
        </a>
        {allTags.map((tag) => (
          <a href={`#tag=${encodeURIComponent(tag)}`} class="tag-filter" data-tag-filter={tag}>{tag}</a>
        ))}
      </div>
    )}

    <div class="posts-list">
      {posts.map((post) => (
        <div class="post-item" data-tags={JSON.stringify(post.data.tags)}>
          <PostCard
            title={post.data.title}
            date={post.data.date}
            slug={post.id}
            tags={post.data.tags}
            description={post.data.description}
          />
        </div>
      ))}
    </div>

    <p class="empty" hidden>
      <span data-i18n="en">No posts found for this tag. <a href="#all">Show all posts</a>.</span>
      <span data-i18n="zh">该标签下暂无文章。<a href="#all">显示全部文章</a>。</span>
    </p>
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--text-secondary);
    font-size: 1rem;
    margin: 0;
  }

  .tag-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .tag-filter {
    display: inline-block;
    background: var(--bg-card);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    padding: 0.2em 0.65em;
    border-radius: 4px;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .tag-filter:hover,
  .tag-filter.active {
    background: var(--accent-dim);
    border-color: var(--accent)66;
    color: var(--accent);
  }

  .posts-list {
    border-top: 1px solid var(--border);
  }

  .post-item[hidden] {
    display: none;
  }

  .empty {
    color: var(--text-muted);
    text-align: center;
    padding: 3rem 0;
  }
</style>

<script>
  const filters = [...document.querySelectorAll<HTMLAnchorElement>('[data-tag-filter]')];
  const postItems = [...document.querySelectorAll<HTMLElement>('.post-item')];
  const empty = document.querySelector<HTMLElement>('.empty');

  const applyFilter = () => {
    const tag = location.hash.startsWith('#tag=') ? decodeURIComponent(location.hash.slice(5)) : 'all';
    let visible = 0;

    postItems.forEach((item) => {
      const tags = JSON.parse(item.dataset.tags || '[]') as string[];
      const matches = tag === 'all' || tags.includes(tag);
      item.hidden = !matches;
      if (matches) visible += 1;
    });

    filters.forEach((filter) => {
      const active = filter.dataset.tagFilter === tag || (tag === 'all' && filter.dataset.tagFilter === 'all');
      filter.classList.toggle('active', active);
      if (active) filter.setAttribute('aria-current', 'page');
      else filter.removeAttribute('aria-current');
    });
    if (empty) empty.hidden = visible > 0;
  };

  window.addEventListener('hashchange', applyFilter);
  applyFilter();
</script>
